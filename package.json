{
  "name": "harness-pet",
  "version": "0.1.0-beta.5-final",
  "private": true,
  "description": "Desktop pets that react to your coding agents. Ships with Clawrk the crab; make, share and import your own.",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --config electron-builder.config.js --win --x64 --publish never",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:security:electron": "electron scripts/smoke-security.js",
    "test:smoke:menu": "node scripts/smoke-menutest.js",
    "test:smoke:rest": "electron scripts/smoke-rest.js",
    "validate": "node scripts/validate-pet.js",
    "hooks:claude": "node lib/claude-hooks.js install",
    "hooks:claude:remove": "node lib/claude-hooks.js uninstall",
    "icon": "node lib/icon.js",
    "build:native": "node scripts/build-native.js",
    "perf": "node scripts/perf.js"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
